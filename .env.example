# Copy this file to .env and edit what you need. Every value is optional;
# the defaults in compose.yaml match the values below.
#
# .env is read both by Docker Compose (for ${VAR:-default} interpolation) and
# by `make backfill-year`.

VERSION=0.1.0

# Logging (json or text, debug/info/warn/error)
LOG_LEVEL=info
LOG_FORMAT=json

# Simulated fleet. Keep SIM_SEED and SIM_FANLESS_RATIO in sync with the
# backfill: the seed service passes them through automatically.
SIM_DEVICES=20
SIM_SEED=1
SIM_FANLESS_RATIO=0.1
SIM_PUBLIC_URL=http://simulator:9200

# NATS
NATS_REPLICAS=1

# Query service
QUERY_TIMEOUT=10s

# Writer batching
WRITER_BATCH_ROWS=50000
WRITER_BATCH_WAIT=2s
WRITER_FETCH_MSGS=500

# Host ports
QUERY_PORT=8080
SIMULATOR_PORT=9200
SCRAPER_STATUS_PORT=9300
WRITER_STATUS_PORT=9400
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Optional resource limits applied to every service. 0 means unlimited.
MEM_LIMIT=0
CPUS=0
